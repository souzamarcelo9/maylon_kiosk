# ── Backend legado (PHP + MySQL) ────────────────────────────────
# O navegador NUNCA fala com ele direto. Só as rotas /api/kiosk/*.
MAYLON_API_BASE=https://api.maylon.com.br
MAYLON_API_TOKEN=troque-isto

# ── Identidade do totem ─────────────────────────────────────────
# Cada tablet recebe o seu no provisionamento.
NEXT_PUBLIC_KIOSK_ID=KIOSK-PRAIAMAR-01
NEXT_PUBLIC_KIOSK_LABEL=Shopping Praiamar - Entrada Principal

# Origem fixa. Preenchida quando o totem não deve usar GPS
# (dentro de prédio o GPS erra feio, e no totem a origem é conhecida).
NEXT_PUBLIC_KIOSK_ORIGIN_LABEL=Av. 9 de Abril, 2500 - Centro, Cubatão
NEXT_PUBLIC_KIOSK_ORIGIN_LAT=-23.8955
NEXT_PUBLIC_KIOSK_ORIGIN_LNG=-46.4256

# ── Pagamento ───────────────────────────────────────────────────
# mock            → aprova em 3s. Use até a certificação da Getnet sair.
# getnet_app2app  → Get Smart ao lado, via polling de claim.
MAYLON_PAYMENT_DRIVER=mock
MAYLON_TERMINAL_ID=TERM-PRAIAMAR-01

# Link público de acompanhamento (tela 8 e SMS)
NEXT_PUBLIC_TRACKING_BASE=https://maylon.com.br/t
