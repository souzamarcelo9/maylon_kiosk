+/**
+ * POST /api/customer/ride/arrival-time
+ *
+ * O detalhe da corrida não traz previsão de chegada — `estimated_time`
+ * é a duração da viagem, não o tempo até o motorista chegar. O tempo de
+ * chegada é uma rota separada.
+ *
+ * Falha aqui não é fatal: a tela 8 simplesmente não mostra o "chega em".
+ */
+export async function getArrivalMinutes(tripId: string): Promise<number | undefined> {
+  try {
+    const raw = await call<Record<string, any>>(
+      '/api/customer/ride/arrival-time',
+      { method: 'POST', body: JSON.stringify({ trip_request_id: tripId }) },
+    );
+    const d = raw.data ?? raw;
+    const value = d.arrival_time ?? d.duration ?? d.eta ?? d.time;
+    const minutes = num(value, -1);
+    return minutes >= 0 ? Math.round(minutes) : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+/** GeoJSON do backend: coordinates = [lng, lat]. Nessa ordem. */
+function geoPoint(value: unknown): { lat: number; lng: number } {
+  const c = (value as { coordinates?: unknown[] })?.coordinates;
+  if (Array.isArray(c) && c.length >= 2) {
+    return { lng: num(c[0]), lat: num(c[1]) };
+  }
+  return { lat: 0, lng: 0 };
 }
 
