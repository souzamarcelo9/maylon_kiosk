diff --git a/src/app/globals.css b/src/app/globals.css
index ab3b73f..1a48e9d 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -40,6 +40,15 @@ body {
   height: 100%;
 }
 
+/*
+ * dvh, não vh. No Chrome Android o 100vh inclui a faixa da barra de
+ * endereço mesmo quando ela está recolhida, então 100vh sempre estoura
+ * e cria rolagem. dvh acompanha a área realmente visível.
+ */
+.h-screen-safe {
+  min-height: 100dvh;
+}
+
 body {
   font-family: var(--font-sans);
   color: var(--color-ink);
@@ -57,10 +66,56 @@ textarea {
   user-select: text;
 }
 
+/*
+ * ── Escala fluida ───────────────────────────────────────────────
+ *
+ * Totem não tem um tamanho só. O mesmo build roda em tablet de 8"
+ * em retrato e em monitor de 27" em paisagem. Tamanho fixo em px
+ * quebra num dos dois extremos — na prática, estourava em retrato e
+ * exigia rolagem justamente na tela de formulário.
+ *
+ * Cada passo é clamp(mínimo, fluido, máximo): o mínimo garante
+ * legibilidade no tablet pequeno, o máximo evita texto gigante no
+ * monitor grande. A parte fluida usa vmin, não vw, para reagir
+ * também à altura — é a altura que falta em retrato.
+ */
+.t-display { font-size: clamp(1.9rem, 5.2vmin, 3.75rem); line-height: 1.1; }
+.t-title   { font-size: clamp(1.4rem, 3.4vmin, 2.5rem);  line-height: 1.15; }
+.t-lead    { font-size: clamp(1.05rem, 2.3vmin, 1.6rem); line-height: 1.3; }
+.t-body    { font-size: clamp(1rem, 2vmin, 1.5rem);      line-height: 1.35; }
+.t-label   { font-size: clamp(0.95rem, 1.8vmin, 1.25rem); line-height: 1.3; }
+.t-hint    { font-size: clamp(0.85rem, 1.5vmin, 1.125rem); line-height: 1.3; }
+.t-price   { font-size: clamp(1.8rem, 4.6vmin, 3.5rem);  line-height: 1.05; }
+
+/* Respiro interno dos cartões, também fluido. */
+.pad-card { padding: clamp(1.25rem, 3.4vmin, 3.5rem); }
+.pad-tight { padding: clamp(1rem, 2.4vmin, 2.5rem); }
+
+/*
+ * Tela larga mas baixa (1280x600, monitor deitado em nicho raso) é o
+ * caso que vmin não resolve sozinho: ele olha a menor dimensão, mas
+ * quem falta é a altura. Aqui o que sobra é ornamento — o logo dentro
+ * do cartão sai, já que a marca já apareceu na tela inicial.
+ */
+@media (max-height: 820px) and (min-aspect-ratio: 1/1) {
+  .hide-short { display: none; }
+  .pad-card { padding: clamp(0.9rem, 2.2vmin, 2rem); }
+  .t-hint { font-size: 0.8rem; }
+  .field-h,
+  .touch-target { min-height: 52px; height: auto; }
+  .field-h { height: 52px; }
+  nav[aria-label='Etapas'] { margin-bottom: 0.25rem; }
+}
+
 /* Alvos de toque em totem são grandes. Ninguém acerta 40px em pé,
-   com mala na mão, num tablet a 1,4 m do chão. */
+   com mala na mão, num tablet a 1,4 m do chão. O piso de 56px é o
+   mínimo recomendado; abaixo disso a taxa de erro dispara. */
 .touch-target {
-  min-height: 72px;
+  min-height: clamp(56px, 8.5vmin, 76px);
+}
+
+.field-h {
+  height: clamp(56px, 8.5vmin, 76px);
 }
 
 /* Foco visível de verdade — acessibilidade não é opcional aqui. */
