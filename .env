# ── Backend Maylon ──────────────────────────────────────────────
MAYLON_API_BASE=https://auth.maylon.com.br

# Token do dispositivo. Gerado por:
#   php artisan kiosk:create "KIOSK-PRAIAMAR-01" "..." --lat= --lng= ...
# Aparece UMA vez; o banco guarda só o hash. Perdeu? `kiosk:rotate`.
MAYLON_KIOSK_TOKEN=yB4WQBRd1mwgjKjjEhGf6xryZsXkWrubrc9pqKLW8YxQY3fN

# ── Identidade (fallback; o real vem de GET /api/kiosk/config) ──
NEXT_PUBLIC_KIOSK_ID=KIOSK-PRAIAMAR-01
NEXT_PUBLIC_KIOSK_LABEL=Shopping Praiamar - Entrada Principal
NEXT_PUBLIC_APP_VERSION=0.1.0

# ── Pagamento ───────────────────────────────────────────────────
# mock           → aprova em 3s. Use até a certificação da Getnet sair.
# getnet_app2app → Get Smart ao lado, via polling de claim.
MAYLON_PAYMENT_DRIVER=mock
MAYLON_TERMINAL_ID=TERM-PRAIAMAR-01

# Link público de acompanhamento (tela 8 e SMS)
NEXT_PUBLIC_TRACKING_BASE=https://maylon.com.br/t
